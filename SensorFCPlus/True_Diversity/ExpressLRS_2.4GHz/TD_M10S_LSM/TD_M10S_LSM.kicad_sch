				(size 1.27 1.27)
				(color 72 72 72 1)
			)
			(justify left top)
		)
		(uuid "9d96dc38-2a9c-480d-8346-4cf559412aed")
	)
	(text_box "V_battery=3.7V	\nV_f=0.24V\nV_charge=3.0V\nI_charge=100uA for longevity\n"
